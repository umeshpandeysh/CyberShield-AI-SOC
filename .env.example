# ==============================================================================
# CyberShield-AI-SOC Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit your local '.env' file containing secrets to Git!
# ==============================================================================

# --- Global Configurations ---
PROJECT_NAME="CyberShield-AI-SOC"
ENV=development # development, staging, production
DEBUG=true

# --- Backend Server Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-for-jwt-tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configurations ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=cybershield_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis & Task Queue Configurations ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_456

# --- AI Engine Configurations ---
PHISHING_MODEL_PATH="models/phishing_detector_v1"
SPAM_MODEL_PATH="models/spam_classifier_v1"
CONFIDENCE_THRESHOLD=0.82

# --- Third-Party Threat Intelligence Integrations ---
# Register and get keys from these providers:
VIRUSTOTAL_API_KEY="your_virustotal_api_key_here"
ABUSEIPDB_API_KEY="your_abuseipdb_api_key_here"
SHODAN_API_KEY="your_shodan_api_key_here"

# --- ClamAV Integration ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Mail / Ingestion Config ---
# For SMTP listener or mail fetching pipelines
MAIL_INBOX_IMAP_SERVER="imap.example.com"
MAIL_INBOX_USER="soc-ingestion@example.com"
MAIL_INBOX_PASSWORD="imap-secure-password"
MAIL_INBOX_PORT=993
